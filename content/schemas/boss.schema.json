{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["id", "nameKey", "world", "hp", "phases", "traits", "moveset", "abilities", "voicePack", "colour"],
  "properties": {
    "id": { "type": "string" },
    "nameKey": { "type": "string" },
    "titleKey": { "type": "string" },
    "world": { "type": "string" },
    "hp": { "type": "number", "minimum": 1 },
    "phases": { "type": "number", "minimum": 1, "maximum": 3 },
    "traits": {
      "type": "object",
      "required": ["aggression", "caution", "trickery", "patience", "showmanship"],
      "properties": {
        "aggression": { "type": "number", "minimum": 0, "maximum": 1 },
        "caution": { "type": "number", "minimum": 0, "maximum": 1 },
        "trickery": { "type": "number", "minimum": 0, "maximum": 1 },
        "patience": { "type": "number", "minimum": 0, "maximum": 1 },
        "showmanship": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "moveset": { "type": "string" },
    "abilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "trigger", "effect"],
        "properties": {
          "id": { "type": "string" },
          "trigger": {
            "type": "object",
            "required": ["type", "value"],
            "properties": {
              "type": { "enum": ["onHpBelow", "onPlayerStreak", "onDistanceHeld", "onTimer", "onPhaseEnter", "onAllyDown"] },
              "value": { "type": "number" },
              "range": { "enum": ["near", "far"] }
            }
          },
          "effect": { "type": "string" },
          "counter": { "type": "string" },
          "once": { "type": "boolean" },
          "cooldown": { "type": "number" }
        }
      }
    },
    "voicePack": { "type": "string" },
    "scale": { "type": "number" },
    "colour": { "type": "string" },
    "accent": { "type": "string" },
    "weapon": { "type": "string" },
    "speed": { "type": "number" },
    "contactDamage": { "type": "number" },
    "miniBoss": { "type": "boolean" },
    "randomTraits": { "type": "boolean" },
    "gimmick": { "type": "string" },
    "cafeGameKey": { "type": "string" }
  }
}
