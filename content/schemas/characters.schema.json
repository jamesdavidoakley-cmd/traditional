{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["heroes", "cast"],
  "definitions": {
    "character": {
      "type": "object",
      "required": ["id", "nameKey", "colour", "subtitleColour", "voice"],
      "properties": {
        "id": { "type": "string" },
        "nameKey": { "type": "string" },
        "colour": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "accent": { "type": "string" },
        "subtitleColour": { "type": "string" },
        "role": { "type": "string" },
        "voice": {
          "type": "object",
          "required": ["id", "rate", "pitch"],
          "properties": {
            "rate": { "type": "number", "minimum": 0.5, "maximum": 2 },
            "pitch": { "type": "number", "minimum": 0, "maximum": 2 }
          }
        }
      }
    }
  },
  "properties": {
    "heroes": { "type": "array", "minItems": 4, "items": { "$ref": "#/definitions/character" } },
    "cast": { "type": "array", "items": { "$ref": "#/definitions/character" } }
  }
}
