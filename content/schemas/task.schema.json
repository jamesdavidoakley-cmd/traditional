{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["id", "archetype", "titleKey", "topicId", "companion"],
  "properties": {
    "id": { "type": "string" },
    "archetype": { "enum": ["sort", "measure", "path", "quickfire", "build", "circuit", "shadow", "fraction"] },
    "titleKey": { "type": "string" },
    "topicId": { "type": "string" },
    "companion": { "type": "string" },
    "introKey": { "type": "string" },
    "sort": {
      "type": "object",
      "required": ["categories", "items", "itemsPerRound"],
      "properties": {
        "categories": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["id", "labelKey", "colour"],
            "properties": { "id": { "type": "string" }, "labelKey": { "type": "string" }, "colour": { "type": "string" } }
          }
        },
        "items": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "required": ["id", "label", "category"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "category": { "type": "string" },
              "shape": { "type": "string" },
              "colour": { "type": "string" },
              "fact": { "type": "string" }
            }
          }
        },
        "itemsPerRound": { "type": "object" }
      }
    },
    "measure": {
      "type": "object",
      "required": ["mode", "prompts"],
      "properties": {
        "mode": { "enum": ["jug", "scales", "money"] },
        "prompts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["tier", "target", "unit", "text", "hint", "explain"],
            "properties": { "tier": { "enum": [1, 2, 3] }, "target": { "type": "number" } }
          }
        }
      }
    },
    "path": {
      "type": "object",
      "required": ["mode", "tiers"],
      "properties": { "mode": { "enum": ["multiples", "sequence", "coordinates"] }, "tiers": { "type": "object" } }
    },
    "quickfire": {
      "type": "object",
      "required": ["count"],
      "properties": { "topicId": { "type": "string" }, "count": { "type": "number", "minimum": 1 } }
    },
    "build": {
      "type": "object",
      "required": ["mode", "tiers"],
      "properties": { "mode": { "enum": ["gears", "counterweight", "springs", "bridge"] }, "tiers": { "type": "object" } }
    },
    "reward": {
      "type": "object",
      "properties": {
        "fossilId": { "type": "string" },
        "gadgetId": { "type": "string" },
        "brainPower": { "type": "number" }
      }
    }
  }
}
