{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["characterId", "pools"],
  "properties": {
    "characterId": { "type": "string" },
    "pools": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "minLength": 2 }
      }
    }
  }
}
