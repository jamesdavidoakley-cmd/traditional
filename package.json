{
  "name": "max-and-the-star-fossils",
  "private": true,
  "version": "0.2.0",
  "description": "A joyful 3D collect-a-thon platformer where Max the blue T-Rex earns Star Fossils by playing real KS2 science, maths and engineering.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate": "node tools/validate-content.mjs",
    "test": "vitest run",
    "test:ai": "vitest run tests/ai-sim.test.ts",
    "test:smoke": "node tools/smoke.mjs",
    "ci": "npm run typecheck && npm run validate && npm run test"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/three": "^0.169.0",
    "playwright-core": "^1.62.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "postprocessing": "^6.36.3",
    "three": "^0.169.0",
    "three-mesh-bvh": "^0.7.8"
  }
}
